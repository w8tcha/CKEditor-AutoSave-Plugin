{
  "name": "ckeditor-autosave-plugin",
  "version": "0.18.7",
  "author": "w8tcha",
  "description": "Auto Save Plugin for the CKEditor which automatically saves the content (via HTML5 LocalStorage) ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w8tcha/CKEditor-AutoSave-Plugin.git"
  },
  "keywords": [
    "CKEditor",
    "Autosave",
    "localStorage",
    "html5"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "moment": "^2.31.0"
  },
  "scripts": {
    "update-deps": "set npm_config_allow_scripts=&& npm-check -y",
    "build": "node build.js",
    "watch": "node build.js --watch"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
